# ----------------------------------------------------------------------------
# LeadForge AI — Frontend Environment Variables
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to git.
# ----------------------------------------------------------------------------

# --- Local development only ---
# Points the Next.js dev proxy to the Express backend.
# Leave this UNSET (or delete the line) when deploying to Vercel — the app
# will use relative /api/* paths which Vercel routes to the serverless function.
NEXT_PUBLIC_API_URL=http://localhost:4000

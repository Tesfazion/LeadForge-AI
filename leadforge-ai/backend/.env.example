# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:1101
BACKEND_URL=http://localhost:4000

# --- Authentication ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
OAUTH_STATE_SECRET=

# --- Database (Prisma) ---
# Local: postgresql://user:password@localhost:5432/leadforge
# Supabase: use the connection string from Project Settings > Database
DATABASE_URL="postgresql://user:password@localhost:5432/leadforge"

# --- AI Providers ---
# OpenRouter API Key (sk-or-v1-...) - Routes to multiple LLM providers
# Get your key from: https://openrouter.ai/keys
# OpenRouter provides access to GPT-4, Claude, Llama, and other models through one unified API
OPENAI_API_KEY=sk-or-v1-...
# Base64-encoded 32-byte key used to encrypt workspace AI credentials at rest.
AI_KEY_ENCRYPTION_KEY=
# Optional if you want the Chat Agent to use Claude instead of/alongside GPT
ANTHROPIC_API_KEY=sk-ant-...

# --- Billing (scaffold only; checkout remains disabled) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Lead Source Integrations ---
# Apollo.io - Can use either API Key OR OAuth credentials
APOLLO_API_KEY=
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=

HUNTER_API_KEY=
CLEARBIT_API_KEY=

# --- Email (choose ONE provider path) ---
# Gmail (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Outlook/Microsoft Graph (OAuth2)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_REFRESH_TOKEN=

# --- Deployment (Developer Agent -> Vercel) ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Optional generated-site backend provisioning ---
SUPABASE_SERVICE_ROLE_KEY=
